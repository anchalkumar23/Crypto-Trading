# ── Vega Lab — backend environment ───────────────────────────────────────────
# Copy this file to .env and fill in every CHANGE_ME value before deploying.

# ── Database ──────────────────────────────────────────────────────────────────
# Docker volume mounts to /data inside the container — do not change this path
# unless you also change the volume mount in docker-compose.yml.
DATABASE_URL=sqlite+aiosqlite:////data/vegalab.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your public domain in production, e.g. http://yourdomain.com
# For local Docker testing use http://localhost
FRONTEND_ORIGIN=http://localhost

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_use_a_long_random_string_here
JWT_ACCESS_MIN=15
JWT_REFRESH_DAYS=7

# ── API-key encryption ────────────────────────────────────────────────────────
# Generate a Fernet key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# ── First-run admin account ───────────────────────────────────────────────────
# Used once on first startup to create the admin user.
# After the first login, these values are ignored.
INITIAL_ADMIN_EMAIL=you@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_strong_password

# ── Engine ────────────────────────────────────────────────────────────────────
ENGINE_TICK_SECONDS=30
ENABLE_LIVE_TRADING=false
